<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.smartenergymanager.controller.DashboardController"
      spacing="20"
      style="-fx-padding: 20; -fx-background-color: #f5f5f5;">

    <Label text="Dashboard" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Separator/>

    <Label text="Batiments" style="-fx-font-size: 15px; -fx-font-weight: bold;" alignment="CENTER"/>
    <HBox spacing="15" alignment="CENTER">
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #ccc, 5, 0, 0, 2);" prefWidth="150">
            <Label text="Total bâtiments" style="-fx-text-fill: grey; -fx-font-size: 11px;"/>
            <Label fx:id="nbBatiment" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #ccc, 5, 0, 0, 2);" prefWidth="150">
            <Label text="Maisons" style="-fx-text-fill: grey; -fx-font-size: 11px;"/>
            <Label fx:id="nbMaison" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #ccc, 5, 0, 0, 2);" prefWidth="150">
            <Label text="Appartements" style="-fx-text-fill: grey; -fx-font-size: 11px;"/>
            <Label fx:id="nbAppartement" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #ccc, 5, 0, 0, 2);" prefWidth="150">
            <Label text="Bureaux" style="-fx-text-fill: grey; -fx-font-size: 11px;"/>
            <Label fx:id="nbBureau" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #ccc, 5, 0, 0, 2);" prefWidth="150">
            <Label text="Universitaires" style="-fx-text-fill: grey; -fx-font-size: 11px;"/>
            <Label fx:id="nbBatimentUniversitaire" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #ccc, 5, 0, 0, 2);" prefWidth="150">
            <Label text="Locaux commerciaux" style="-fx-text-fill: grey; -fx-font-size: 11px;"/>
            <Label fx:id="nbLocalCommercial" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>
    <Separator/>

    <Label text="Relevés" style="-fx-font-size: 15px; -fx-font-weight: bold;" alignment="CENTER"/>
    <HBox spacing="15" alignment="CENTER">
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #ccc, 5, 0, 0, 2);" prefWidth="150">
            <Label text="Total Relevés" style="-fx-text-fill: grey; -fx-font-size: 11px;"/>
            <Label fx:id="nbReleves" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #ccc, 5, 0, 0, 2);" prefWidth="150">
            <Label text="Electricité" style="-fx-text-fill: grey; -fx-font-size: 11px;"/>
            <Label fx:id="nbRelevesElectricite" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #ccc, 5, 0, 0, 2);" prefWidth="150">
            <Label text="Eau" style="-fx-text-fill: grey; -fx-font-size: 11px;"/>
            <Label fx:id="nbRelevesEau" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #ccc, 5, 0, 0, 2);" prefWidth="150">
            <Label text="Gaz" style="-fx-text-fill: grey; -fx-font-size: 11px;"/>
            <Label fx:id="nbRelevesGaz" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #ccc, 5, 0, 0, 2);" prefWidth="150">
            <Label text="Chauffage" style="-fx-text-fill: grey; -fx-font-size: 11px;"/>
            <Label fx:id="nbRelevesChauffage" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #ccc, 5, 0, 0, 2);" prefWidth="150">
            <Label text="Climatisation" style="-fx-text-fill: grey; -fx-font-size: 11px;"/>
            <Label fx:id="nbRelevesClimatisation" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>
    <Separator/>


</VBox>
